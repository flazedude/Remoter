# Copy to deployment/.env; replace these placeholders before starting.
REMOTER_RELAY_DOMAIN=relay.example.com
# Generate DISTINCT random tokens for every device and role. No example secret
# below is usable. Never commit the populated .env file.
REMOTER_RELAY_DEVICES='{"office-pc":{"hostToken":"REPLACE_WITH_RANDOM_HOST_TOKEN","viewerToken":"REPLACE_WITH_DIFFERENT_RANDOM_VIEWER_TOKEN"}}'
